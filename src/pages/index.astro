---
// TEMPORARY: token and type check for the Setup step. Replaced when the Home page is built.
import BaseLayout from '../layouts/BaseLayout.astro';

const textStyles = [
  'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
  'body-xl', 'body-l', 'body-m', 'body-s',
  'title-l', 'title-m', 'title-s',
  'label-l', 'label-m', 'label-s', 'label-xs',
  'number-xl', 'number-l', 'number-m',
];

const textColors = [
  'text-primary', 'text-heading-brand', 'text-tertiary', 'text-secondary',
  'text-label', 'text-link-active',
];

const surfaces = [
  'bg-primary', 'bg-subtle', 'bg-secondary', 'bg-inverse', 'bg-action', 'bg-icon-subtle',
  'pearl-bg', 'pearl-bg-dark', 'sampath-bg-warm', 'sampath-bg-dark',
];

const spacing = [2, 4, 6, 8, 12, 16, 24, 32, 36, 40, 48, 56, 64, 72, 80, 120, 172, 240];
const radii = ['sm', 'md', 'lg', 'full'];
---

<BaseLayout title="Token check · Sathila De Silva">
  <main class="container check">
    <header>
      <p class="text-label-m eyebrow">Setup · temporary page</p>
      <h1>Designing products and the systems that hold them together.</h1>
    </header>

    <section>
      <h2 class="text-h6">Text styles</h2>
      <ul role="list" class="type-list">
        {textStyles.map((s) => (
          <li>
            <code class="text-body-s">{s}</code>
            <span class={`text-${s}`}>{s.startsWith('number') ? '120+' : 'Sathila De Silva'}</span>
          </li>
        ))}
        <li>
          <code class="text-body-s">pearl-quote</code>
          <span class="text-pearl-quote">The exception proved the rule.</span>
        </li>
      </ul>
    </section>

    <section>
      <h2 class="text-h6">Text colours</h2>
      <ul role="list" class="row">
        {textColors.map((c) => (
          <li class="text-title-l" style={`color: var(--${c})`}>{c}</li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-h6">Surfaces</h2>
      <ul role="list" class="swatches">
        {surfaces.map((c) => (
          <li>
            <span class="swatch" style={`background: var(--${c})`}></span>
            <code class="text-body-s">{c}</code>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-h6">Gradients</h2>
      <ul role="list" class="swatches">
        {['gradient-brand', 'gradient-fintech', 'gradient-info-icon'].map((g) => (
          <li>
            <span class="swatch" style={`background: var(--${g})`}></span>
            <code class="text-body-s">{g}</code>
          </li>
        ))}
      </ul>
      <p class="text-h5 fintech">Fintech</p>
    </section>

    <section>
      <h2 class="text-h6">Spacing</h2>
      <ul role="list" class="spacing">
        {spacing.map((n) => (
          <li>
            <code class="text-body-s">{n}</code>
            <span class="bar" style={`width: var(--space-${n})`}></span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-h6">Radii</h2>
      <ul role="list" class="row">
        {radii.map((r) => (
          <li>
            <span class="radius" style={`border-radius: var(--radius-${r})`}></span>
            <code class="text-body-s">{r}</code>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .check {
    display: flex;
    flex-direction: column;
    gap: var(--space-80);
    padding-block: var(--space-120);
  }
  header {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .eyebrow,
  code {
    color: var(--text-tertiary);
  }
  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .type-list li {
    display: grid;
    grid-template-columns: 96px 1fr;
    align-items: baseline;
    gap: var(--space-16);
    padding-block: var(--space-8);
    border-bottom: 1px solid var(--border-default);
  }
  .row,
  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-24);
  }
  .swatches li,
  .row li {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .swatch,
  .radius {
    display: block;
    width: var(--space-120);
    height: var(--space-64);
    border: 1px solid var(--border-default);
  }
  .radius {
    background: var(--bg-subtle);
  }
  .fintech {
    width: fit-content;
    background: var(--gradient-fintech);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .spacing li {
    display: grid;
    grid-template-columns: 48px 1fr;
    align-items: center;
    gap: var(--space-16);
    padding-block: var(--space-4);
  }
  .bar {
    display: block;
    height: var(--space-8);
    background: var(--bg-action);
  }
</style>
