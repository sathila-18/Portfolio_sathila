---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/pearl/Hero.astro';
import HeroMeta from '../components/pearl/HeroMeta.astro';
import Metrics from '../components/pearl/Metrics.astro';
import Setup from '../components/pearl/Setup.astro';
import FirstMove from '../components/pearl/FirstMove.astro';
import ArchitectureCall from '../components/pearl/ArchitectureCall.astro';
import Foundations from '../components/pearl/Foundations.astro';
import BuildingEngine from '../components/pearl/BuildingEngine.astro';
import ThirdSurface from '../components/pearl/ThirdSurface.astro';
---

<!-- darkHero: the nav goes white over Pearl's dark bands (metrics, "Building the Engine"),
     marked with data-dark-hero as they're built. -->
<BaseLayout
  title="Pearl Design System · Sathila De Silva"
  description="Case study: Pearl, the design system behind Batelco's self-care app, web app and website."
  darkHero
  pageBg="--pearl-bg"
>
  <main>
    <Hero />
    <HeroMeta />
    <Metrics />
    <Setup />
    <FirstMove />
    <ArchitectureCall />
    <Foundations />
    <BuildingEngine />
    <ThirdSurface />
  </main>
</BaseLayout>
