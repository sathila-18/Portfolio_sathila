---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/pearl/Hero.astro';
import HeroMeta from '../components/pearl/HeroMeta.astro';
import Metrics from '../components/pearl/Metrics.astro';
---

<!-- darkHero: the nav goes white over Pearl's dark bands (metrics, "Building the Engine"),
     marked with data-dark-hero as they're built. -->
<BaseLayout
  title="Pearl Design System · Sathila De Silva"
  description="Case study: Pearl, the design system behind Batelco's self-care app, web app and website."
  darkHero
  pageBg="--pearl-bg"
>
  <main>
    <Hero />
    <HeroMeta />
    <Metrics />
  </main>
</BaseLayout>
