---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/megt/Hero.astro';
import HeroMeta from '../components/megt/HeroMeta.astro';
import HeroMedia from '../components/megt/HeroMedia.astro';
import Metrics from '../components/megt/Metrics.astro';
import Body from '../components/megt/Body.astro';
import Context from '../components/megt/Context.astro';
import Challenge from '../components/megt/Challenge.astro';
import HowItWasBuilt from '../components/megt/HowItWasBuilt.astro';
import Product from '../components/megt/Product.astro';
import BeforeAfter from '../components/megt/BeforeAfter.astro';
import CanvasBehavior from '../components/megt/CanvasBehavior.astro';
import DesignSystem from '../components/megt/DesignSystem.astro';
import Reflections from '../components/megt/Reflections.astro';
---

<!-- darkHero: the nav goes white over MEGT's dark bands (metrics, "How it was built",
     "Design system"), marked with data-dark-hero as they're built. -->
<BaseLayout
  title="MEGT Form Builder · Sathila De Silva"
  description="Case study: a node-based form builder replacing Google Forms and spreadsheets for MEGT Australia's case workers."
  darkHero
  pageBg="--bg-subtle"
>
  <main>
    <Hero />
    <HeroMeta />
    <HeroMedia />
    <Metrics />
    <Body>
      <Context />
      <Challenge />
      <HowItWasBuilt />
      <Product />
      <BeforeAfter />
      <CanvasBehavior />
      <DesignSystem />
      <Reflections />
    </Body>
  </main>
</BaseLayout>
