---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sampath/Hero.astro';
import StartingPoint from '../components/sampath/StartingPoint.astro';
import PlanChanged from '../components/sampath/PlanChanged.astro';
import BuildingSystem from '../components/sampath/BuildingSystem.astro';
import Components from '../components/sampath/Components.astro';
import ComponentCollage from '../components/sampath/ComponentCollage.astro';
import Impact from '../components/sampath/Impact.astro';
import BuiltToLast from '../components/sampath/BuiltToLast.astro';
---

<BaseLayout
  title="Sampath Design System · Sathila De Silva"
  description="Case study: building the Sampath Design System for digital banking in Sri Lanka."
  darkHero
>
  <main>
    <Hero />
    <StartingPoint />
    <PlanChanged />
    <BuildingSystem />
    <Components />
    <ComponentCollage />
    <Impact />
    <BuiltToLast />
  </main>
</BaseLayout>
