---
import '../styles/tokens.css';
import '../styles/base.css';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** The page has dark regions (marked `data-dark-hero`); the nav goes white while one is behind it. */
  darkHero?: boolean;
  /** Page background token, e.g. `--pearl-bg` (DESIGN.md › Layout); shows behind the top nav. */
  pageBg?: string;
}

const {
  title,
  description = 'Sathila De Silva: designing products and the systems that hold them together.',
  darkHero = false,
  pageBg,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Only Google Sans Flex (400–600, with optical size so large text matches Figma) and Google Sans Code italic (Pearl only) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,400..600&family=Google+Sans+Code:ital,wght@1,400&display=swap"
    />
  </head>
  <body style={pageBg ? `background-color: var(${pageBg})` : undefined}>
    <TopNav watchDark={darkHero} />
    <slot />
    <Footer />
  </body>
</html>
