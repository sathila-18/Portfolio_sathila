---
// MEGT › Honest reflections (DESIGN.md › Layout › MEGT case study, item 6): section heading, then
// five reflections, two per row with the last centred, rows 80 apart. Each card is 516 tall as in
// Figma, text at the bottom and a particle mark (✓ or ✗) centred in the space above it. White
// cards with rounded.md on bg-subtle (user's decision; Figma has no card background).
// 120px under Design system; Figma's 207 to the footer snapped to 240.
import SectionHeading from './SectionHeading.astro';
import ParticleMark from './ParticleMark.astro';

// Widths are Figma's text boxes, so the titles and takeaways wrap as designed.
const reflections = [
  {
    keep: true,
    title: 'Building the design system first was the right call',
    titleWidth: 446,
    body: 'It’s tempting to treat a system as something to tidy up once the features are done. On this project, it was the other way round. The weekend spent on foundations is what let six sprints of harder and harder features still look like one product.',
    takeaway: 'Foundations first, features second.',
  },
  {
    keep: false,
    title: 'I got the type scale wrong early on',
    titleWidth: 298,
    body: 'My H6 was 16px and my H5 was 26px, a jump far too big for a product built around dense tables. I only noticed once real screens were being built, and by then fixing it meant reworking screens already in progress. If I’d had wireframes first, I could have checked the scale against them before building anything.',
    takeaway: 'Check the type scale against real layouts before building on it.',
  },
  {
    keep: true,
    title: 'Designing the dashboard last was the right decision',
    titleWidth: 446,
    body: 'Waiting until every flow was clear meant the dashboard showed what the product actually did. The developers still needed something to build around in the meantime, so we gave them one of our early dashboard ideas, the one we thought was closest to where the final would land. When the real dashboard arrived, it slotted into a layout they already knew.',
    takeaway: 'Don’t design the summary before you know what it’s summarising.',
    takeawayWidth: 472,
  },
  {
    keep: false,
    title: 'We never tested with the case workers themselves',
    titleWidth: 446,
    body: 'The client was happy with the designs, but client approval isn’t the same as user validation. We didn’t have access to the case workers who’d use this tool every day, so their feedback never made it in before handoff. The workflow builder in particular deserved real user feedback before handoff.',
    takeaway: 'Ask for user access early, even if the sessions have to be remote.',
  },
  {
    keep: true,
    title: 'Leaning on patterns people already knew',
    titleWidth: 446,
    body: 'Typeform shaped the form builder, folders like Google Drive shaped the question library, Discord shaped the permissions, and editing tools shaped the canvas. None of it was copied, but each one meant case workers wouldn’t have to learn something new from scratch. With a complex tool and no access to its users, familiar patterns were the closest thing we had to their feedback.',
    takeaway: 'When you can’t test with users, design with what they already know.',
    takeawayWidth: 417,
  },
];
---

<section id="reflections" class="reflections" aria-labelledby="reflections-title">
  <SectionHeading id="reflections-title" eyebrow="Honest reflections" width={687}>
    What I’d keep.<br /> What I’d change
  </SectionHeading>

  <ul class="cards">
    {reflections.map(({ keep, title, titleWidth, body, takeaway, takeawayWidth }) => (
      <li class="card" tabindex="0" data-particle-trigger>
        <div class="art">
          <ParticleMark mark={keep ? 'check' : 'cross'} />
        </div>
        <h3 class="text-h6" style={`max-width: ${titleWidth}px`}>
          <span class="visually-hidden">{keep ? 'Would keep' : 'Would change'}: </span>{title}
        </h3>
        <p class="body text-body-l">{body}</p>
        <p class="takeaway text-title-m" style={takeawayWidth ? `max-width: ${takeawayWidth}px` : undefined}>{takeaway}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .reflections {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
    margin-block: var(--space-120); /* 120 above the footer (user's decision) */
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-80) var(--space-24);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Figma: 588 × 516, padding 24, gap 24, centred text at the bottom; white card (user). */
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-24);
    min-height: 516px;
    padding: var(--space-24);
    border-radius: var(--radius-md);
    background-color: var(--bg-cards);
    text-align: center;
  }

  .card:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .card:last-child {
    grid-column: 1 / -1;
    justify-self: center;
    width: calc((100% - var(--space-24)) / 2);
  }

  /* The particles fill the top of the card, out to its edges; the mark forms at the centre. */
  .card {
    overflow: hidden;
  }

  .art {
    position: relative;
    flex: 1;
    align-self: stretch;
    min-height: 160px;
    margin: calc(-1 * var(--space-24)) calc(-1 * var(--space-24)) 0;
  }

  h3 {
    color: var(--text-primary);
  }

  p {
    margin: 0;
  }

  .body {
    color: var(--text-secondary);
  }

  .takeaway {
    color: var(--text-tertiary);
    white-space: pre-line;
  }

  /* Mobile: one per row, as tall as their content. */
  @media (max-width: 767px) {
    /* Mobile: 48 between sections (user's decision). */
    .reflections {
      margin-top: var(--space-48);
      gap: var(--space-32); /* Mobile: content 32 below the heading block. */
      margin-bottom: var(--space-48); /* 48 above the footer */
    }

    .cards {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-36); /* Mobile: 36 between cards (user's decision). */
    }

    .card {
      min-height: 0;
      padding: var(--space-16);
    }

    .art {
      flex: none;
      height: 200px;
      margin: calc(-1 * var(--space-16)) calc(-1 * var(--space-16)) 0;
    }

    .card:last-child {
      width: 100%;
    }
  }
</style>
