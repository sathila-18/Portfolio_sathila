---
// MEGT › The product (DESIGN.md › Layout › MEGT case study, item 6; Figma 212:1049): section
// heading, then four feature tabs above a form builder preview and its caption. 120px under How
// it was built.
//
// Tabs 02–04 reuse the Form canvas image and caption as placeholders until their content
// exists (user's decision). Tabs are one line ("01 Form canvas", title-m) with 8px corners
// (rounded.sm); the active state uses the portfolio blue (user's decision; Figma has violet).
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import builder from '../../assets/images/megt/02_hero-form-builder-preview__image-form-builder.png';

const caption =
  'Every assessment starts with a name and a business unit, then opens onto the three-panel canvas, with questions on the left, the form in the middle and settings on the right. Each question type had to feel like part of the same form, and it took many rounds of iteration before one layout could carry them all.';

const features = [
  { id: 'canvas', title: 'Form canvas', image: builder, alt: 'The form builder canvas with the question type picker open.', caption },
  {
    id: 'workflow',
    title: 'Workflow builder',
    image: builder,
    alt: 'The form builder canvas with the question type picker open.',
    caption:
      'Branching logic is where forms usually get confusing, since one answer can lead somewhere completely different. So each question connects to the next as a node, and case workers can see exactly where every answer goes. We also designed a screen for every situation the logic could run into, so nothing would leave them stuck halfway through a form.',
  },
  {
    id: 'library',
    title: 'Question library',
    image: builder,
    alt: 'The form builder canvas with the question type picker open.',
    caption:
      'Saved questions pile up quickly, and finding the right one can turn into a search of its own. So we built the library to work like folders in Google Drive, SharePoint or Windows, places most people already know how to find things in. Questions can be browsed as a table or a grid, whichever suits the moment.',
  },
  {
    id: 'assessment',
    title: 'Assessment view',
    image: builder,
    alt: 'The form builder canvas with the question type picker open.',
    caption:
      'This is where the assessment is actually carried out, one question at a time, on any device. Once an answer is chosen, its interventions appear, and one has to be picked before moving on, with room for a comment on every question. Each template can also have its own colours. Whatever colour someone picked, we only changed its HSL lightness, setting backgrounds at 98 and 95 so text always stayed readable, and the developers built the same rule into the code.',
  },
];
---

<section id="product" class="product" aria-labelledby="product-title">
  <SectionHeading
    id="product-title"
    eyebrow="The product"
    lead="A form builder for case workers had a lot to handle quietly. Branching logic, interventions, roles and permissions, and a library of reusable questions, all behind screens that were never meant to feel technical. These are the four places it all came together."
    width={996}
  >
    See how the form builder works.
  </SectionHeading>

  <div class="showcase" data-tabs>
    <div class="tabs" role="tablist" aria-label="Product features">
      {features.map(({ id, title }, i) => (
        <button
          class="tab text-title-m"
          id={`product-tab-${id}`}
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`product-panel-${id}`}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="number">{String(i + 1).padStart(2, '0')}</span>
          <span class="title">{title}</span>
        </button>
      ))}
    </div>

    {features.map(({ id, image, alt, caption }, i) => (
      <div
        class="panel"
        id={`product-panel-${id}`}
        role="tabpanel"
        aria-labelledby={`product-tab-${id}`}
        hidden={i !== 0}
      >
        <div class="preview">
          <Image
            class="shot"
            src={image}
            alt={alt}
            widths={[934, 1868]}
            sizes="(min-width: 1800px) 934px, 78vw"
          />
        </div>
        <p class="caption text-body-m">{caption}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .product {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
    margin-top: var(--space-120);
  }

  .showcase {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    container-type: inline-size;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .panel[hidden] {
    display: none;
  }

  /* Figma: the 934 × 526 screenshot centred in a 1200 × 537 frame. */
  .preview {
    display: grid;
    place-items: center;
    aspect-ratio: 1200 / 537;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .shot {
    width: calc(934 / 1200 * 100%);
    height: auto;
    border-radius: 4px; /* artwork */
  }

  /* Figma: 918 wide, centred under the preview. */
  .caption {
    width: 100%;
    max-width: 918px;
    margin: 0 auto;
    color: var(--text-secondary);
  }

  .tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-24);
  }

  /* Inactive: 1px border-media, number and title in heading-brand (blue 900). Active: 2px portfolio
     blue 500 border on blue 50, title in text-primary; padding trimmed by 1px so the tabs stay the
     same size. */
  .tab {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-16);
    border: 1px solid var(--border-media);
    border-radius: var(--radius-sm);
    background: none;
    font-family: inherit;
    text-align: left;
    white-space: nowrap;
    color: var(--text-heading-brand);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .tab:hover {
    border-color: var(--primary-1-500);
  }

  .tab:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .tab[aria-selected='true'] {
    padding: calc(var(--space-16) - 1px);
    border: 2px solid var(--primary-1-500);
    background-color: var(--primary-1-50);
  }

  .tab[aria-selected='true'] .title {
    color: var(--text-primary);
  }

  /* Four across need about 800px for "04 Assessment view" to stay on one line; narrower
     content columns (tablet) go two by two. */
  @container (max-width: 799px) {
    .tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Mobile: the preview fills the width, as the screenshot is too small inside its frame. */
  @media (max-width: 767px) {
    /* Mobile: 48 between sections (user's decision). */
    .product {
      margin-top: var(--space-48);
      gap: var(--space-32); /* Mobile: content 32 below the heading block. */
    }

    .preview {
      aspect-ratio: auto;
    }

    .shot {
      width: 100%;
    }

    .tabs {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-12);
    }
  }
</style>

<script>
  // Tabs (WAI-ARIA tabs pattern): click or arrow keys switch the panel; Home/End jump to the ends.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const other of tabs) {
        const selected = other === tab;
        other.setAttribute('aria-selected', String(selected));
        other.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(other.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !selected;
      }
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const next = {
          ArrowRight: tabs[(i + 1) % tabs.length],
          ArrowLeft: tabs[(i - 1 + tabs.length) % tabs.length],
          Home: tabs[0],
          End: tabs[tabs.length - 1],
        }[event.key];
        if (next) {
          event.preventDefault();
          select(next, true);
        }
      });
    });
  }
</script>
