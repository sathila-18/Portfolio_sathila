---
// MEGT › Section heading (DESIGN.md › Components › Section heading): eyebrow, h2, then an
// optional lead paragraph 48px below. The section adds its content 48px below that.
interface Props {
  id: string;
  eyebrow: string;
  lead?: string;
  /** Lead width from Figma; DESIGN.md keeps the h2 to ~690. */
  leadWidth?: number;
  /** Figma width of the whole heading block, when narrower than 690 (sets where the h2 wraps). */
  width?: number;
}

const { id, eyebrow, lead, leadWidth, width } = Astro.props;
---

<header class="heading" style={width ? `max-width: ${width}px` : undefined}>
  <div class="titles">
    <p class="eyebrow text-label-m">{eyebrow}</p>
    <h2 id={id}><slot /></h2>
  </div>
  {lead && <p class="lead text-body-xl" style={leadWidth ? `max-width: ${leadWidth}px` : undefined}>{lead}</p>}
</header>

<style>
  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
  }

  .titles {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .eyebrow {
    color: var(--text-tertiary);
  }

  /* text-primary, as on Pearl and Sampath (user's decision; Figma has some in heading-brand). */
  h2 {
    max-width: 690px;
    color: var(--text-primary);
  }

  .lead {
    color: var(--text-secondary);
  }
</style>
