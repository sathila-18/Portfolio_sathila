---
// MEGT › Hero introduction (DESIGN.md › Layout › MEGT case study, item 2): eyebrow, h1
// headline and lead paragraph in the 1200 container.

// Joins items with the Figma separator (" · "); the non-breaking space keeps each dot
// on the line before it when the text wraps.
const list = (...items: string[]) => items.join(' · ');
---

<section class="hero container" aria-labelledby="megt-hero-title">
  <p class="eyebrow text-h6">{list('MEGT Australia', 'Enterprise Web App', '2024')}</p>
  <div class="text">
    <h1 id="megt-hero-title">A form builder for case workers who can’t afford to break it</h1>
    <p class="lead text-body-xl">
      MEGT helps job seekers back into work through Workforce Australia, the Australian Government’s
      employment service. For every person they support, the first step is an assessment, and the
      answers decide what help comes next. Yet those assessments were still being built by hand in
      Google Forms and Typeform, tools that were never made for this work. Our answer started as a
      two-day pitch, and over six sprints it grew into a full product, with developers building
      alongside us from the first sprint onward.
    </p>
  </div>
</section>

<style>
  /* Starts below the fixed nav, like every page. Figma: 50px under the nav, snapped to 48. */
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin-top: calc(var(--nav-height) + var(--space-48));
  }

  .eyebrow {
    color: var(--text-tertiary);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  h1 {
    max-width: 1175px;
    color: var(--text-primary);
  }

  .lead {
    max-width: 835px;
    color: var(--text-secondary);
  }

</style>
