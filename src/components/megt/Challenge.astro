---
// MEGT › The challenge (DESIGN.md › Layout › MEGT case study, item 6, and Components › Info
// card): section heading, then four info cards, two per row. 120px under Context.
import SectionHeading from './SectionHeading.astro';
import alertIcon from '../../assets/icons/megt/challenge-alert.svg';
import contrastIcon from '../../assets/icons/megt/contrast.svg';
import layoutIcon from '../../assets/icons/megt/layout-spacing.svg';
import accessibilityIcon from '../../assets/icons/megt/accessibility.svg';

const cards = [
  {
    icon: alertIcon,
    title: 'Three roles, one coherent system',
    body: 'Super Admins oversee the whole product, from business units to users, roles and permissions, while Admins and Site Admins are the ones building assessments. Each role needed its own experience, but it all still had to feel like one tool.',
  },
  {
    icon: contrastIcon,
    title: 'Visual conditional logic',
    body: 'Every question could branch, and nodes had been the plan since the pitch. Once building started, our UX researcher and I wondered if it was too big an ask for the developers. It was still the best option for case workers, so we made our case, and the developers found a way to build it. The challenge then was making it feel approachable, not like a developer tool.',
  },
  {
    icon: layoutIcon,
    title: 'Two responsive briefs, one project',
    body: 'Admins build forms at a desk, but assessments had to work on any device. That made the builder and the assessments two different responsive problems, running side by side.',
  },
  {
    icon: accessibilityIcon,
    title: 'Dashboard designed last, intentionally',
    body: 'A dashboard summarises the product, so it couldn’t be designed before the product existed. We held it back until every other flow was clear, so it would reflect what the tool actually did.',
  },
];
---

<section id="challenge" class="challenge" aria-labelledby="challenge-title">
  <SectionHeading
    id="challenge-title"
    eyebrow="The challenge"
    lead="Case workers needed a tool that could handle branching logic, interventions and permissions without ever feeling complicated. Holding those two things together was the real problem in every sprint, and it shaped every decision, from the design system to the final screen."
    width={647}
  >
    Powerful enough for complexity. Simple enough to actually use.
  </SectionHeading>

  <ul class="cards">
    {cards.map(({ icon, title, body }) => (
      <li class="card">
        <img class="icon" src={icon.src} alt="" width="32" height="32" />
        <div class="copy">
          <h3 class="text-h6">{title}</h3>
          <p class="text-body-l">{body}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .challenge {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
    margin-top: var(--space-120);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-24);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-16);
    border-radius: var(--radius-md);
    background-color: var(--bg-cards);
  }

  .icon {
    display: block;
    width: 32px;
    height: 32px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  h3 {
    color: var(--text-primary);
  }

  p {
    margin: 0;
    color: var(--text-secondary);
  }

  /* Mobile: one card per row. */
  @media (max-width: 767px) {
    /* Mobile: 48 below Context, matching the 48 of light background around the dark bands (user's decision). */
    .challenge {
      margin-top: var(--space-48);
      gap: var(--space-32); /* Mobile: content 32 below the heading block. */
    }

    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
