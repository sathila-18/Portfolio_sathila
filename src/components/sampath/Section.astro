---
// Sampath › numbered section band (DESIGN.md › Layout › Sampath case study, item 3):
// full-bleed warm or dark background, 1200 container with 64px side and 120px vertical padding.
interface Props {
  tone: 'warm' | 'dark';
  /** id of the section heading, for aria-labelledby. */
  labelledby: string;
  /** Bottom padding of 56 instead of 120 (80 on mobile), e.g. when an image band follows. */
  tightBottom?: boolean;
}

const { tone, labelledby, tightBottom = false } = Astro.props;
---

<!-- Dark bands also switch the top nav to white while they're behind it. -->
<section
  class:list={['band', tone]}
  aria-labelledby={labelledby}
  data-dark-hero={tone === 'dark' ? '' : undefined}
>
  <div class:list={['inner', { 'tight-bottom': tightBottom }]}>
    <slot />
  </div>
</section>

<style>
  .warm {
    background-color: var(--sampath-bg-warm);
  }

  .dark {
    background-color: var(--sampath-bg-dark);
  }

  .inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-120) var(--space-64);
  }

  /* Tablet and mobile: side padding follows the page gutter. */
  @media (max-width: 1199px) {
    .inner {
      padding-inline: var(--gutter);
    }
  }

  /* Mobile: shorter vertical padding (recommendation, not in Figma). */
  @media (max-width: 767px) {
    .inner {
      padding-block: var(--space-80);
    }
  }

  .inner.tight-bottom {
    padding-bottom: var(--space-56);
  }
</style>
