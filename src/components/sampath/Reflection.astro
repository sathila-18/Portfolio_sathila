---
// Sampath › 08 — Reflection: heading, then three numbered lessons (title + text), Figma 182:7.
import Section from './Section.astro';

const lessons = [
  {
    title: 'Let AI set the direction, not the final UI.',
    text: 'The AI prototype won the client over within days, and at a glance it looked finished. It was only when I worked through it screen by screen in Figma that the extra steps, the mismatched patterns and the missing edge cases showed up.',
  },
  {
    title: 'Name tokens for what they do, not what they’re for today.',
    text: 'Calling the color tokens fg-primary instead of icon-primary felt like a small naming call at the time. Then the illustrations arrived and could use the same tokens, and when dark mode came in, icons and illustrations switched together.',
  },
  {
    title: 'Write the intent down, not just the name.',
    text: 'A token name is enough for a person who knows the product, but AI only knows what’s written. The usage descriptions I added in Figma travelled into the JSON export, and that’s what let Claude Code build the chat prototype without guessing.',
  },
];
---

<Section tone="warm-alt" labelledby="reflection-title" last>
  <h2 id="reflection-title">
    <span class="line">What I'd tell myself</span>{' '}
    <span class="line">on day one.</span>
  </h2>

  <ol class="lessons" role="list">
    {lessons.map(({ title, text }, i) => (
      <li class="lesson">
        <span class="num text-title-m">{String(i + 1).padStart(2, '0')}</span>
        <div class="lesson-text">
          <h3 class="text-title-l">{title}</h3>
          <p class="text-body-l">{text}</p>
        </div>
      </li>
    ))}
  </ol>
</Section>

<style>
  h2 {
    color: var(--text-primary);
  }

  /* Two lines from tablet up, as in Figma; on mobile it wraps naturally. */
  @media (min-width: 768px) {
    .line {
      display: block;
    }
  }

  /* Numbers share one column (subgrid), so all three texts start at the same x. */
  .lessons {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: var(--space-16);
    margin-top: var(--space-56);
  }

  .lesson {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: start;
    padding-block: var(--space-24);
    color: var(--text-primary);
  }

  .lesson-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .lesson-text p {
    color: var(--text-secondary);
  }

  /* Lines between rows only, not above the first or below the last, as in Impact (user). */
  .lesson + .lesson {
    border-top: 1px solid var(--sampath-border-warm-alt);
  }

  .lesson:first-child {
    padding-top: 0;
  }

  .lesson:last-child {
    padding-bottom: 0;
  }
</style>
