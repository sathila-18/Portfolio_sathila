---
// Sampath › 08 — Reflection: heading, then three numbered lessons.
import Section from './Section.astro';

const lessons = [
  "AI moves fast for direction but it won't catch what's wrong until you're close to it in Figma. The screens unlocked the project. They also had structural problems only visible when working through the UI properly. Both things are true at the same time.",
  'Naming tokens for intent rather than content is the decision that compounds. fg-primary instead of icon-primary felt minor at the time. It saved meaningful rework when illustrations entered the project and again in dark mode. One naming call, weeks of rework avoided.',
  "Building for AI readability isn't something to plan for later. Documentation that works for a BA or a PM is the same documentation that works for an AI agent. Write it that way from the start.",
];
---

<Section tone="warm-alt" labelledby="reflection-title">
  <h2 id="reflection-title">
    <span class="line">What I'd tell myself</span>{' '}
    <span class="line">on day one.</span>
  </h2>

  <ol class="lessons" role="list">
    {lessons.map((text, i) => (
      <li class="lesson">
        <span class="num text-title-m">{String(i + 1).padStart(2, '0')}</span>
        <p class="text-body-l">{text}</p>
      </li>
    ))}
  </ol>
</Section>

<style>
  h2 {
    color: var(--text-primary);
  }

  /* Two lines from tablet up, as in Figma; on mobile it wraps naturally. */
  @media (min-width: 768px) {
    .line {
      display: block;
    }
  }

  /* Numbers share one column (subgrid), so all three texts start at the same x. */
  .lessons {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: var(--space-16);
    margin-top: var(--space-56);
  }

  .lesson {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: start;
    padding-block: var(--space-24);
    color: var(--text-tertiary);
  }

  /* Lines between rows only, not above the first or below the last, as in Impact (user). */
  .lesson + .lesson {
    border-top: 1px solid var(--sampath-border-warm-alt);
  }

  .lesson:first-child {
    padding-top: 0;
  }

  .lesson:last-child {
    padding-bottom: 0;
  }
</style>
