---
// Sampath › Hero (Figma "sampath-chat-test" › hero 1, node 156:2927). Light hero: eyebrow, h1
// and h5 lead on the left, then the metadata band over a blurred strip of the silk image.
import { Image } from 'astro:assets';
import silk from '../../assets/images/sampath/01_hero__meta-silk.png';
import Dot from './Dot.astro';

// Joins items with the Figma separator ("  ·  "); the non-breaking spaces keep each dot
// on the line before it when the text wraps.
const list = (...items: string[]) => items.join('  ·  ');

// Multi-word tools use a non-breaking space so a name never splits across lines.
// Each value: an optional emphasised first line, then the regular line.
const meta = [
  { label: 'Role', lead: 'Design system lead', text: 'Final UI delivery' },
  { label: 'Timeline', lead: '3 months to phase-one launch', text: 'System ready in 2.5 days' },
  { label: 'Industry', text: list('Digital banking', 'Sri Lanka') },
  { label: 'Tools', text: list('Figma', 'Figma Variables', 'Claude Code', 'Widgetbook', 'Notion') },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="intro">
    <p class="eyebrow text-h6">
      <Dot />
      <span class="eyebrow-text">{list('Design system', 'Fintech', 'Sri Lanka', '2026')}</span>
    </p>
    <div class="text">
      <h1 id="hero-title" class="title">
        <span class="line">Sampath</span> <span class="line">Design System</span>
      </h1>
      <p class="subtitle text-h5">
        Built in 2.5 days. 96 onboarding screens the next day. 400+ screens since, and now moving
        into code.
      </p>
    </div>
  </div>

  <!-- Figma: the 1920 × 887 silk image, blurred 25px and centred on the band, so only its
       middle strip shows. A 19% black layer sits on top under a 40px backdrop blur. -->
  <div class="meta" data-dark-hero>
    <Image class="silk" src={silk} alt="" widths={[silk.width]} loading="eager" />
    <dl class="cells">
      {meta.map(({ label, lead, text }) => (
        <div class="cell">
          <dt class="text-label-s">{label}</dt>
          <dd>
            {lead && <span class="lead text-label-l">{lead}</span>}
            <span class="value text-body-l">{text}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* Starts below the fixed nav, like every page. */
  .hero {
    margin-top: var(--nav-height);
    background-color: var(--bg-primary);
  }

  /* Figma: 120 from the left edge. Equal space above and below so the block sits in the
     middle of the white area (user's decision; Figma has 163 above and 96 below). */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-24);
    padding-block: var(--space-120);
    padding-inline: var(--space-120);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    color: var(--text-tertiary);
  }

  .eyebrow-text {
    white-space: pre-wrap;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    max-width: var(--sampath-hero-text-width);
  }

  .title {
    color: var(--text-primary);
  }

  .subtitle {
    color: var(--text-secondary);
  }

  /* Two lines from tablet up, as in Figma; on mobile the title wraps naturally. */
  @media (min-width: 768px) {
    .line {
      display: block;
    }
  }

  /* Desktop: the hero fills the window below the nav, so the band always sits on the bottom
     edge (user's decision). The text stays centred in the white area; on short windows its
     padding shrinks to 48 so the band still fits. */
  @media (min-width: 1200px) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: calc(100svh - var(--nav-height));
    }

    .intro {
      flex: 1;
      justify-content: center;
      padding-block: var(--space-48);
    }
  }

  /* ── Metadata band ─────────────────────────────────────────────── */

  /* Figma: 88 side padding + 32 in each cell puts the text on the 120 line. */
  .meta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-inline: calc(var(--space-120) - var(--space-32));
    color: var(--text-white);
  }

  .silk {
    position: absolute;
    z-index: -2;
    top: 50%;
    left: 0;
    width: 100%;
    height: var(--sampath-hero-silk-height);
    translate: 0 -50%;
    /* Scaled up a little so the blur's soft edges fall outside the band at the sides. */
    scale: 1.05;
    object-fit: cover;
    filter: blur(var(--sampath-hero-silk-blur));
  }

  /* Black at the nav's 19% (user's decision, replacing Figma's grey overlay image), so the
     blurred silk still shows through. */
  .meta::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background-color: var(--sampath-hero-meta-bg);
    -webkit-backdrop-filter: blur(var(--sampath-hero-meta-blur));
    backdrop-filter: blur(var(--sampath-hero-meta-blur));
    pointer-events: none;
  }

  .cells {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-32);
  }

  .cell + .cell {
    border-left: 1px solid var(--sampath-border-white-subtle);
  }

  dt {
    text-transform: uppercase;
  }

  dd {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .value {
    color: var(--sampath-text-white-muted);
    white-space: pre-wrap;
  }

  /* Tablet: gutter padding, two by two, dividers on the inner edges only. */
  @media (max-width: 1199px) {
    .intro {
      padding-block: var(--space-80);
      padding-inline: var(--gutter);
    }

    .meta {
      padding-inline: 0;
    }

    .cells {
      grid-template-columns: repeat(2, 1fr);
    }

    .cell {
      padding-inline: var(--gutter);
    }

    .cell + .cell {
      border-left: 0;
    }

    .cell:nth-child(odd) + .cell {
      border-left: 1px solid var(--sampath-border-white-subtle);
    }

    .cell:nth-child(n + 3) {
      border-top: 1px solid var(--sampath-border-white-subtle);
    }
  }

  /* Mobile: one column, dividers between rows; the band keeps the silk background. */
  @media (max-width: 767px) {
    .intro {
      padding-top: var(--space-48);
      padding-bottom: calc(2 * var(--space-48));
    }

    /* Mobile keeps the 24 gap between title and lead, as before the Figma update. */
    .text {
      gap: var(--space-24);
    }

    .meta {
      padding-inline: var(--gutter);
    }

    .cells {
      grid-template-columns: 1fr;
    }

    .cell {
      padding-inline: 0;
    }

    .cell:nth-child(odd) + .cell {
      border-left: 0;
    }

    .cell + .cell {
      border-top: 1px solid var(--sampath-border-white-subtle);
    }
  }
</style>
