---
// Top nav, shared by every page (DESIGN.md › Components › Top nav).
import Logo from '../assets/images/logo-s.svg';

const links = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: 'mailto:sathilasilva@yahoo.com' },
];

const currentPath = Astro.url.pathname;
---

<header class="top-nav">
  <a class="logo" href="/" aria-label="Sathila De Silva, home">
    <Logo width={18} height={24} aria-hidden="true" />
  </a>

  <nav aria-label="Main">
    <ul role="list">
      {links.map(({ label, href }) => (
        <li>
          <a
            class="text-label-l"
            href={href}
            aria-current={href === currentPath ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .top-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    padding-inline: var(--gutter);
    background-color: var(--nav-bg);
    -webkit-backdrop-filter: blur(var(--nav-blur));
    backdrop-filter: blur(var(--nav-blur));
  }

  /* Padding keeps the touch target at 44px+ without moving the 18×24 mark. */
  .logo {
    display: block;
    padding: var(--space-12);
    margin: calc(-1 * var(--space-12));
  }

  ul {
    display: flex;
    gap: var(--space-40);
  }

  nav a {
    display: block;
    padding-block: var(--space-12);
    color: var(--text-tertiary);
    transition: color var(--duration-base) var(--ease-out);
  }

  nav a:hover {
    color: var(--text-primary);
  }

  /* Desktop: full-width nav with 120px side padding (wider than the 1200 container). */
  @media (min-width: 1200px) {
    .top-nav {
      padding-inline: var(--space-120);
    }
  }
</style>
